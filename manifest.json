{
  "manifest_version": 3,
  "name": "propaganda_nuke",
  "version": "0.2.0",
  "description": "A calm, brutal filter against manipulative news, social feeds, and emotional capture.",
  "permissions": ["storage", "tabs", "scripting", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "propaganda_nuke"
  },
  "options_page": "options.html",
  "storage": {
    "managed_schema": "managed_storage_schema.json"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "war_room/fallout_map.js",
        "war_room/incident_manager.js",
        "counter_measures/scenarios.js",
        "counter_measures/semantic_nuke.js",
        "content.js"
      ],
      "css": ["theme.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["blocked.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
